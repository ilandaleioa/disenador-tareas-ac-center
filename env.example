# Copia este archivo como ".env" (en esta misma carpeta) y rellena tus valores.
# El archivo ".env" NO se sube a GitHub. No compartas tu clave por chat ni por correo.

# Clave de la API de Claude (opcional: sin ella el diseñador funciona, pero sin asistente de IA).
ANTHROPIC_API_KEY=

# Modelo de IA (opcional). Para gastar menos: claude-sonnet-5-5 o claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Puerto local (opcional, por defecto 8090)
PORT=8090

# Ruta completa a ffmpeg.exe (opcional; solo si no está en el PATH). Se usa para convertir vídeo.
# FFMPEG=C:\ruta\a\ffmpeg.exe
